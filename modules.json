        "package_selection": {
          "github.com/faustbrian/go-validation/v2": "Use for typed validators, explicit value presence, bounded reports, paths, violations, composition, and cancellation-aware async validation.",
          "github.com/faustbrian/go-validation/v2/adapters/config": "Use to adapt typed validation to a narrow configuration Validate error contract.",
          "github.com/faustbrian/go-validation/v2/adapters/http": "Use to project bounded validation findings into router-neutral RFC 9457-inspired HTTP problem details after routing context termination.",
          "github.com/faustbrian/go-validation/v2/adapters/jsonapi": "Use to project bounded validation findings into JSON:API error documents after routing context termination.",
          "github.com/faustbrian/go-validation/v2/adapters/jsonrpc": "Use to project bounded validation findings into JSON-RPC invalid-params errors after routing context termination.",
          "github.com/faustbrian/go-validation/v2/adapters/service": "Use for cancellation-aware service-boundary validation hooks without depending on a service runtime.",
          "github.com/faustbrian/go-validation/v2/rules": "Use for reusable deterministic presence, string, numeric, collection, temporal, cross-field, and primitive validators.",
          "github.com/faustbrian/go-validation/v2/structplan": "Use when startup-time typed or tagged field registration should compile into an immutable reusable validation plan.",
          "github.com/faustbrian/go-validation/v2/validationconfig": "Retained deprecated integration path; prefer github.com/faustbrian/go-validation/v2/adapters/config for new integrations.",
          "github.com/faustbrian/go-validation/v2/validationhttp": "Retained deprecated integration path; prefer github.com/faustbrian/go-validation/v2/adapters/http for new integrations.",
          "github.com/faustbrian/go-validation/v2/validationjsonapi": "Retained deprecated integration path; prefer github.com/faustbrian/go-validation/v2/adapters/jsonapi for new integrations.",
          "github.com/faustbrian/go-validation/v2/validationobserve": "Use to emit bounded non-sensitive validation observations without importing an observability backend.",
          "github.com/faustbrian/go-validation/v2/validationrpc": "Retained deprecated integration path; prefer github.com/faustbrian/go-validation/v2/adapters/jsonrpc for new integrations.",
          "github.com/faustbrian/go-validation/v2/validationservice": "Retained deprecated integration path; prefer github.com/faustbrian/go-validation/v2/adapters/service for new integrations.",
          "github.com/faustbrian/go-validation/v2/validationtest": "Use in tests for stable report assertions and validation conformance helpers.",
          "github.com/faustbrian/go-validation/v2/validationtext": "Use to apply caller-owned localized message catalogs without changing machine-readable validation identity."
        },
